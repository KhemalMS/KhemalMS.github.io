---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import ContributionGrid from '../components/ContributionGrid.astro';
import StatusTimeline from '../components/StatusTimeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGrid from '../components/SkillGrid.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { getFeatured, toSummary, getProjects } from '../lib/projects';

const locale = 'id' as const;
const t = ui[locale];
const featured = await getFeatured(locale);
const all = await getProjects(locale);
const projectsHref = localizePath('/projects/', locale);
---

<Base>
  <Nav locale={locale} />

  <main id="main">
    <Hero locale={locale} />
    <StatsBar locale={locale} />

    <section id="projects" class="border-t border-line py-16 md:py-24">
      <div class="container-page">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold tracking-widest text-accent uppercase">
              {t.projectsSection.eyebrow}
            </p>
            <h2 class="mt-3 text-2xl font-bold sm:text-3xl">{t.projectsSection.title}</h2>
          </div>
          <a
            href={projectsHref}
            class="group inline-flex items-center gap-1.5 text-sm font-semibold text-fg-muted transition-colors hover:text-fg"
          >
            {t.projectPage.allProjects}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0">→</span>
          </a>
        </div>

        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-fg-muted">
          {t.projectsSection.subtitle}
        </p>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {
            featured.map((p) => (
              <ProjectCard locale={locale} project={toSummary(p)} />
            ))
          }
        </div>

        <p class="mt-6 text-sm text-fg-muted">
          <span class="font-semibold text-fg">{all.length}</span>
          <span class="ml-1.5">{t.projectsSection.count}</span>
        </p>
      </div>
    </section>

    <StatusTimeline locale={locale} />
    <ContributionGrid locale={locale} />
    <About locale={locale} />
    <SkillGrid locale={locale} />
    <Contact locale={locale} />
  </main>

  <Footer locale={locale} />
</Base>
