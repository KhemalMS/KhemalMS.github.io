---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { ui } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';

const locale = 'en' as const;
const t = ui[locale];
---

<Base title="404" noindex>
  <Nav locale={locale} />
  <main id="main" class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-7xl font-bold tracking-tighter text-sky-300 dark:text-sky-800">{t.notFound.code}</p>
    <h1 class="mt-4 text-2xl font-bold">{t.notFound.title}</h1>
    <p class="mt-2 max-w-sm text-sm text-fg-muted">{t.notFound.subtitle}</p>
    <a
      href={localizePath('/', locale)}
      class="mt-8 inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg"
    >
      {t.notFound.back}
    </a>
  </main>
  <Footer locale={locale} />
</Base>
