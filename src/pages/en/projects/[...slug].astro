---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import { ui } from '../../../i18n/ui';
import { localizePath } from '../../../i18n/utils';
import { getProjects, slugOf } from '../../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map((entry, i) => ({
    params: { slug: slugOf(entry) },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, next } = Astro.props;
const locale = 'en' as const;
const t = ui[locale];
const d = entry.data;
const { Content } = await render(entry);
const back = localizePath('/projects/', locale);
const nextHref = localizePath(`/projects/${slugOf(next)}/`, locale);

const external = (href: string) => ({ target: '_blank', rel: 'noopener noreferrer' as const, href });
---

<Base title={d.title} description={d.summary} ogType="article" ogImage={d.cover?.src ?? '/og.png'}>
  <Nav locale={locale} />

  <main id="main">
    <article>
      <header class="border-b border-line bg-bg-subtle py-12 md:py-16">
        <div class="container-page">
          <a
            href={back}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-fg-muted transition-colors hover:text-fg"
          >
            <span aria-hidden="true">â†</span> {t.projectPage.back}
          </a>

          <div class="mt-6 flex flex-wrap items-center gap-2 text-xs">
            <span class="font-semibold tracking-wide text-accent uppercase">{d.category}</span>
            <span class="text-line" aria-hidden="true">|</span>
            <span class="text-fg-muted">{d.year}</span>
            <span
              class="rounded-full border border-line bg-surface px-2 py-0.5 text-[0.7rem] font-semibold text-fg-muted"
            >
              {t.statusLabels[d.status]}
            </span>
          </div>

          <h1 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            {d.title}
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-fg-muted">{d.tagline}</p>

          <dl class="mt-8 grid gap-4 text-sm sm:grid-cols-3">
            <div>
              <dt class="text-xs font-semibold tracking-wide text-fg-muted uppercase">
                {t.projectPage.role}
              </dt>
              <dd class="mt-1 font-medium text-fg">{d.role}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold tracking-wide text-fg-muted uppercase">
                {t.projectPage.year}
              </dt>
              <dd class="mt-1 font-medium text-fg">{d.year}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold tracking-wide text-fg-muted uppercase">
                {t.projectPage.status}
              </dt>
              <dd class="mt-1 font-medium text-fg">{t.statusLabels[d.status]}</dd>
            </div>
          </dl>

          <div class="mt-8 flex flex-wrap gap-2.5">
            {d.demoUrl && (
              <a
                {...external(d.demoUrl)}
                class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg shadow-card transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
              >
                {t.projectPage.viewDemo}
                <span aria-hidden="true">â†—</span>
              </a>
            )}
            {d.repoUrl && (
              <a
                {...external(d.repoUrl)}
                class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:border-accent"
              >
                {t.projectPage.viewRepo}
                <span aria-hidden="true">â†—</span>
              </a>
            )}
            {d.videoUrl && (
              <a
                href="#video"
                class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:border-accent"
              >
                {t.projectPage.viewVideo}
              </a>
            )}
          </div>
        </div>
      </header>

      {
        d.cover && (
          <div class="border-b border-line bg-coffee-100 dark:bg-coffee-950">
            <div class="container-page py-6 md:py-10">
              <img
                src={d.cover.src}
                alt={d.cover.alt}
                width="1280"
                height="720"
                loading="eager"
                decoding="async"
                class="w-full rounded-xl border border-line shadow-lift"
              />
              {d.cover.caption && (
                <p class="mt-3 text-center text-xs text-fg-muted">{d.cover.caption}</p>
              )}
            </div>
          </div>
        )
      }

      <div class="container-page grid gap-12 py-12 md:grid-cols-[minmax(0,1fr)_18rem] md:py-16">
        <div class="min-w-0">
          {d.status === 'private' && (
            <p class="mb-8 rounded-xl border border-line bg-bg-subtle px-4 py-3 text-xs leading-relaxed text-fg-muted">
              {t.projectPage.privateNote}
            </p>
          )}

          <div class="prose-portfolio">
            <Content />
          </div>

          {
            d.videoUrl && (
              <section id="video" class="mt-12 scroll-mt-24">
                <h2 class="mb-4 text-lg font-bold">{t.projectPage.viewVideo}</h2>
                <VideoEmbed url={d.videoUrl} title={d.title} poster={d.cover?.src} />
              </section>
            )
          }

          {
            d.gallery.length > 0 && (
              <section class="mt-12">
                <h2 class="mb-4 text-lg font-bold">{t.projectPage.highlights}</h2>
                <div class="grid gap-4 sm:grid-cols-2">
                  {d.gallery.map((shot) => (
                    <figure class="overflow-hidden rounded-xl border border-line bg-surface">
                      <img
                        src={shot.src}
                        alt={shot.alt}
                        width="880"
                        height="550"
                        loading="lazy"
                        decoding="async"
                        class="w-full object-cover object-top"
                      />
                      {shot.caption && (
                        <figcaption class="border-t border-line px-4 py-2.5 text-xs text-fg-muted">
                          {shot.caption}
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              </section>
            )
          }
        </div>

        <aside class="md:sticky md:top-24 md:self-start">
          <h2 class="text-xs font-semibold tracking-widest text-fg-muted uppercase">
            {t.projectPage.stack}
          </h2>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {
              d.stack.map((s) => (
                <li class="rounded-full border border-line bg-surface px-2.5 py-1 text-xs font-medium text-fg">
                  {s}
                </li>
              ))
            }
          </ul>

          {
            d.metrics.length > 0 && (
              <>
                <h2 class="mt-8 text-xs font-semibold tracking-widest text-fg-muted uppercase">
                  {t.projectPage.metrics}
                </h2>
                <dl class="mt-3 grid gap-2">
                  {d.metrics.map((m) => (
                    <div class="rounded-xl border border-line bg-surface px-4 py-3">
                      <dt class="text-[0.7rem] font-medium tracking-wide text-fg-muted uppercase">
                        {m.label}
                      </dt>
                      <dd class="text-lg font-bold text-fg">{m.value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )
          }
        </aside>
      </div>
    </article>

    <nav class="border-t border-line bg-bg-subtle py-8" aria-label={t.projectPage.nextProject}>
      <div class="container-page flex flex-wrap items-center justify-between gap-4">
        <span class="text-xs font-semibold tracking-widest text-fg-muted uppercase">
          {t.projectPage.nextProject}
        </span>
        <a
          href={nextHref}
          class="group inline-flex items-center gap-2 text-sm font-semibold text-fg transition-colors hover:text-accent"
        >
          {next.data.title}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0">â†’</span>
        </a>
      </div>
    </nav>
  </main>

  <Footer locale={locale} />
</Base>

<style>
  .prose-portfolio :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .prose-portfolio :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .prose-portfolio :global(p) {
    margin-bottom: 1rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--fg-muted);
  }

  .prose-portfolio :global(ul),
  .prose-portfolio :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--fg-muted);
  }

  .prose-portfolio :global(ul) {
    list-style: disc;
  }

  .prose-portfolio :global(ol) {
    list-style: decimal;
  }

  .prose-portfolio :global(li) {
    margin-bottom: 0.375rem;
  }

  .prose-portfolio :global(li::marker) {
    color: var(--accent);
  }

  .prose-portfolio :global(strong) {
    font-weight: 600;
    color: var(--fg);
  }

  .prose-portfolio :global(code) {
    border-radius: 0.25rem;
    border: 1px solid var(--border);
    padding: 0.1rem 0.35rem;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--fg);
  }

  .prose-portfolio :global(pre) {
    margin-bottom: 1rem;
    overflow-x: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    padding: 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .prose-portfolio :global(pre code) {
    border: 0;
    padding: 0;
    background: transparent;
  }

  .prose-portfolio :global(blockquote) {
    margin-bottom: 1rem;
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .prose-portfolio :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose-portfolio :global(table) {
    margin-bottom: 1rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .prose-portfolio :global(th),
  .prose-portfolio :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose-portfolio :global(th) {
    background: var(--bg-subtle);
    font-weight: 600;
  }

  .prose-portfolio :global(hr) {
    margin: 2rem 0;
    border-color: var(--border);
  }
</style>







