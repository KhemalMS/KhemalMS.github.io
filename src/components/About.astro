---
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<section id="about" class="border-t border-line bg-bg-subtle py-16 md:py-24">
  <div class="container-page grid gap-10 md:grid-cols-[1.4fr_1fr] md:gap-16">
    <div>
      <p class="text-xs font-semibold tracking-widest text-accent uppercase">
        {t.aboutSection.eyebrow}
      </p>
      <h2 class="mt-3 text-2xl font-bold sm:text-3xl">{t.aboutSection.title}</h2>
      <div class="mt-6 space-y-4 text-sm leading-relaxed text-fg-muted">
        {t.aboutSection.body.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <dl class="grid gap-3 self-start rounded-2xl border border-line bg-surface p-5 shadow-card">
      {
        t.aboutSection.facts.map((f) => (
          <div class="flex flex-col gap-0.5 border-b border-line pb-3 last:border-0 last:pb-0">
            <dt class="text-xs font-semibold tracking-wide text-fg-muted uppercase">{f.label}</dt>
            <dd class="text-sm font-medium text-fg">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
