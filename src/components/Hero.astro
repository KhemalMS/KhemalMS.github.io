---
import { ui } from '../i18n/ui';
import { localizePath, type Locale } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const projectsHref = localizePath('/projects/', locale);
const contactHref = `${localizePath('/', locale)}#contact`;
---

<section class="relative overflow-hidden border-b border-line">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(80%_60%_at_50%_-10%,var(--color-coffee-100),transparent_70%)] dark:bg-[radial-gradient(80%_60%_at_50%_-10%,rgb(74_39_29/0.7),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page grid gap-10 py-16 md:grid-cols-[1fr_auto] md:items-center md:gap-16 md:py-24">
    <div class="max-w-2xl">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1 text-xs font-semibold text-fg-muted"
      >
        <span class="relative flex size-2" aria-hidden="true">
          <span
            class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60 motion-reduce:animate-none"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        {t.hero.available}
      </p>

      <p class="text-sm font-medium tracking-wide text-fg-muted uppercase">{t.hero.greeting}</p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        {site.name}
      </h1>

      <p class="mt-4 text-lg text-fg-muted sm:text-xl">
        <span class="text-fg">{t.hero.roles[0]}</span>
        <span class="mx-2 text-accent" aria-hidden="true">·</span>
        <span>{t.hero.roles[1]}</span>
      </p>

      <p class="mt-6 max-w-prose text-base leading-relaxed text-fg-muted">
        {
          locale === 'id'
            ? 'Membangun sistem yang dipakai harian — kasir, inventaris aset, dan dashboard operasional. Next.js, NestJS, Flutter, dan disiplin pada data yang benar.'
            : 'Building software used every day — point of sale, asset inventory, and operational dashboards. Next.js, NestJS, Flutter, and a discipline for correct data.'
        }
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={projectsHref}
          class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg shadow-card transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
        >
          {t.hero.cta}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href={contactHref}
          class="inline-flex items-center rounded-full border border-line px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:border-accent"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="order-first justify-self-center md:order-none md:justify-self-end">
      <div
        class="relative size-40 rounded-full border-8 border-surface bg-coffee-200 shadow-lift sm:size-52 md:size-60"
      >
        <img
          src="/photo.jpg"
          alt={`${site.name} — ${t.hero.roles[0]}`}
          width="480"
          height="480"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="size-full rounded-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
