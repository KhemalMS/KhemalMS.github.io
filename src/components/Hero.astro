---
import { ui } from '../i18n/ui';
import { localizePath, type Locale } from '../i18n/utils';
import { site } from '../data/site';
import { getFeatured, getProjects, toSummary, slugOf } from '../lib/projects';
import { contributions } from '../data/github';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const projectsHref = localizePath('/projects/', locale);
const contactHref = `${localizePath('/', locale)}#contact`;

const allProjects = await getProjects(locale);
const featured = await getFeatured(locale);
const spotlight = featured[0] ?? allProjects[0];
const spotlightSummary = spotlight ? toSummary(spotlight) : null;
const spotlightHref = spotlight ? localizePath(`/projects/${slugOf(spotlight)}/`, locale) : projectsHref;
---

<section class="relative overflow-hidden border-b border-line">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(70%_60%_at_20%_-10%,var(--color-sky-100),transparent_70%)] dark:bg-[radial-gradient(70%_60%_at_20%_-10%,rgb(3_105_161/0.35),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page grid gap-10 py-10 md:grid-cols-[1.15fr_1fr] md:items-center md:gap-12 md:py-16">
    <div class="max-w-2xl">
      <div class="mb-6 flex items-center gap-4">
        <img
          src="/photo.jpg"
          alt={site.name}
          width="56"
          height="56"
          class="size-14 rounded-full border-2 border-sky-400 object-cover shadow-[0_0_15px_rgba(56,189,248,0.35)]"
        />
        <div class="flex flex-wrap items-center gap-2.5">
          <p
            class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3 py-1 text-xs font-semibold text-fg-muted backdrop-blur-sm"
          >
            <span class="relative flex size-2" aria-hidden="true">
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60 motion-reduce:animate-none"
              ></span>
              <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
            </span>
            {t.hero.available}
          </p>
          <span class="text-xs font-medium text-fg-muted">
            • {site.location[locale]}
          </span>
        </div>
      </div>

      <p class="text-sm font-medium tracking-wide text-fg-muted uppercase">{t.hero.greeting}</p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        {site.name}
      </h1>

      <p class="mt-4 text-lg text-fg-muted sm:text-xl">
        <span class="text-fg">{t.hero.roles[0]}</span>
        <span class="mx-2 text-accent" aria-hidden="true">·</span>
        <span>{t.hero.roles[1]}</span>
        {
          t.hero.roles[2] && (
            <>
              <span class="mx-2 text-accent" aria-hidden="true">·</span>
              <span class="text-fg-muted/90">{t.hero.roles[2]}</span>
            </>
          )
        }
      </p>

      <p class="mt-6 max-w-prose text-base leading-relaxed text-fg-muted">{t.hero.intro}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={projectsHref}
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg shadow-card transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
        >
          {t.hero.cta}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href={contactHref}
          class="inline-flex items-center rounded-lg border border-line px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-6 border-t border-line/70 pt-6">
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-tight text-accent tabular-nums sm:text-3xl">
            {allProjects.length}
          </span>
          <span class="text-xs font-medium text-fg-muted sm:text-sm">{t.statsSection.projects}</span>
        </div>
        <div class="h-5 w-px bg-line" aria-hidden="true"></div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-tight text-accent tabular-nums sm:text-3xl">
            {contributions.total}
          </span>
          <span class="text-xs font-medium text-fg-muted sm:text-sm">{t.statsSection.contributions}</span>
        </div>
      </div>
    </div>

    {
      spotlightSummary && (
        <div class="group relative overflow-hidden rounded-2xl border border-line bg-surface p-2 shadow-card transition-all hover:border-accent/40 hover:shadow-lift">
          <a href={spotlightHref} class="block overflow-hidden rounded-xl border border-line/70 bg-bg-subtle">
            <div class="relative aspect-[16/10] overflow-hidden">
              {spotlightSummary.cover ? (
                <img
                  src={spotlightSummary.cover.src}
                  alt={spotlightSummary.cover.alt}
                  width={800}
                  height={500}
                  class="size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="eager"
                />
              ) : (
                <div class="flex size-full items-center justify-center bg-sky-950/20 text-2xl font-bold text-accent">
                  {spotlightSummary.title}
                </div>
              )}
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white">
                <span class="rounded-full bg-black/60 px-2.5 py-0.5 text-xs font-medium backdrop-blur-md">
                  {spotlightSummary.category}
                </span>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-sky-200">
                  Case study <span aria-hidden="true">→</span>
                </span>
              </div>
            </div>
            <div class="p-4 sm:p-5">
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-base font-bold tracking-tight text-fg transition-colors group-hover:text-accent">
                  {spotlightSummary.title}
                </h3>
                <span class="rounded-full border border-line px-2 py-0.5 text-[0.7rem] font-semibold text-fg-muted">
                  {spotlightSummary.year}
                </span>
              </div>
              <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-fg-muted sm:text-sm">
                {spotlightSummary.tagline}
              </p>
              <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tech stack">
                {spotlightSummary.stack.slice(0, 4).map((tech) => (
                  <li class="rounded-md border border-line/80 bg-surface px-2 py-0.5 font-mono text-[0.7rem] font-medium text-fg-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          </a>
        </div>
      )
    }
  </div>
</section>
