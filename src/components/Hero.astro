---
import { ui } from '../i18n/ui';
import { localizePath, type Locale } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const projectsHref = localizePath('/projects/', locale);
const contactHref = `${localizePath('/', locale)}#contact`;

const whoami = [
  `name     ${site.name}`,
  `role     ${t.hero.roles[0]}`,
  `location ${site.location[locale]}`,
  `stack    Next.js · NestJS · Flutter · PostgreSQL`,
  `status   ${t.hero.available}`,
];
---

<section class="relative overflow-hidden border-b border-line">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(70%_60%_at_20%_-10%,var(--color-sky-100),transparent_70%)] dark:bg-[radial-gradient(70%_60%_at_20%_-10%,rgb(3_105_161/0.35),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page grid gap-10 py-16 md:grid-cols-[1.1fr_1fr] md:items-center md:gap-14 md:py-24">
    <div class="max-w-2xl">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3 py-1 text-xs font-semibold text-fg-muted"
      >
        <span class="relative flex size-2" aria-hidden="true">
          <span
            class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60 motion-reduce:animate-none"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        {t.hero.available}
      </p>

      <p class="text-sm font-medium tracking-wide text-fg-muted uppercase">{t.hero.greeting}</p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        {site.name}
      </h1>

      <p class="mt-4 text-lg text-fg-muted sm:text-xl">
        <span class="text-fg">{t.hero.roles[0]}</span>
        <span class="mx-2 text-accent" aria-hidden="true">·</span>
        <span>{t.hero.roles[1]}</span>
      </p>

      <p class="mt-6 max-w-prose text-base leading-relaxed text-fg-muted">{t.hero.intro}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={projectsHref}
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-accent-fg shadow-card transition-transform hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
        >
          {t.hero.cta}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href={contactHref}
          class="inline-flex items-center rounded-lg border border-line px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    <div
      class="overflow-hidden rounded-xl border border-line bg-surface shadow-lift"
      aria-hidden="false"
    >
      <div class="flex items-center gap-1.5 border-b border-line bg-bg-subtle px-4 py-2.5">
        <span class="size-2.5 rounded-full bg-red-400/70"></span>
        <span class="size-2.5 rounded-full bg-amber-400/70"></span>
        <span class="size-2.5 rounded-full bg-emerald-400/70"></span>
        <span class="ml-2 font-mono text-[0.7rem] text-fg-muted">~/portfolio</span>
      </div>
      <div class="overflow-x-auto p-4 font-mono text-[0.8rem] leading-relaxed">
        <p class="text-fg-muted"><span class="text-accent">$</span> whoami</p>
        <dl class="mt-2 space-y-0.5">
          {
            whoami.map((line) => {
              const [k, ...rest] = line.split(' ');
              return (
                <div class="flex gap-3">
                  <dt class="w-20 shrink-0 text-fg-muted">{k}</dt>
                  <dd class="text-fg">{rest.join(' ')}</dd>
                </div>
              );
            })
          }
        </dl>
        <p class="mt-3 text-fg-muted">
          <span class="text-accent">$</span>
          <span class="ml-1.5 inline-block h-3.5 w-1.5 animate-pulse bg-accent align-middle motion-reduce:animate-none"
          ></span>
        </p>
      </div>
    </div>
  </div>
</section>
