---
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/utils';
import { contributions, contributionLevel } from '../data/github';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const dayNames =
  locale === 'id'
    ? ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab']
    : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const levels = [0, 1, 2, 3] as const;

const months =
  locale === 'id'
    ? ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des']
    : ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---

<section class="border-t border-line py-10 md:py-14">
  <div class="container-page">
    <p class="text-xs font-semibold tracking-widest text-accent uppercase">
      {t.contribSection.eyebrow}
    </p>
    <h2 class="mt-3 text-2xl font-bold sm:text-3xl">{t.contribSection.title}</h2>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted">{t.contribSection.subtitle}</p>

    <div class="mt-8 rounded-2xl border border-line bg-surface p-5 shadow-card sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-bg-subtle px-3 py-1.5 text-xs font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          <span>@{contributions.login}</span>
        </a>

        <span class="text-xs font-medium text-fg-muted">
          {t.contribSection.total}
        </span>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-line bg-bg-subtle/60 p-3.5">
          <p class="text-xs font-medium text-fg-muted">
            {locale === 'id' ? 'Total Kontribusi' : 'Total Contributions'}
          </p>
          <p class="mt-1 text-2xl font-bold tracking-tight text-accent tabular-nums">
            {contributions.total}
          </p>
        </div>
        <div class="rounded-xl border border-line bg-bg-subtle/60 p-3.5">
          <p class="text-xs font-medium text-fg-muted">
            {locale === 'id' ? 'Aktivitas Terbanyak' : 'Peak Activity'}
          </p>
          <p class="mt-1 text-2xl font-bold tracking-tight text-fg tabular-nums">
            {contributions.max}
            <span class="text-xs font-normal text-fg-muted">{locale === 'id' ? '/ hari' : '/ day'}</span>
          </p>
        </div>
        <div class="rounded-xl border border-line bg-bg-subtle/60 p-3.5">
          <p class="text-xs font-medium text-fg-muted">
            {locale === 'id' ? 'Status' : 'Status'}
          </p>
          <div class="mt-1 flex items-center gap-2">
            <span class="relative flex size-2.5" aria-hidden="true">
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500 opacity-60 motion-reduce:animate-none"
              ></span>
              <span class="relative inline-flex size-2.5 rounded-full bg-emerald-500"></span>
            </span>
            <span class="text-base font-semibold text-fg">
              {locale === 'id' ? 'Aktif' : 'Active'}
            </span>
          </div>
        </div>
      </div>

      <div class="mt-6 overflow-x-auto pt-4 border-t border-line/70">
        <div class="min-w-[840px]">
          <div
            class="flex justify-between pl-8 pr-1 text-[11px] font-medium text-fg-muted mb-2 select-none"
            aria-hidden="true"
          >
            {months.map((m) => (
              <span>{m}</span>
            ))}
          </div>

          <div
            class="flex items-start gap-2"
            role="img"
            aria-label={`${contributions.total} ${t.contribSection.total}`}
          >
            <div
              class="flex flex-col gap-1 text-[10px] font-medium text-fg-muted select-none w-6 shrink-0 text-right pr-1"
              aria-hidden="true"
            >
              <span class="h-3 leading-3"></span>
              <span class="h-3 leading-3">{locale === 'id' ? 'Sen' : 'Mon'}</span>
              <span class="h-3 leading-3"></span>
              <span class="h-3 leading-3">{locale === 'id' ? 'Rab' : 'Wed'}</span>
              <span class="h-3 leading-3"></span>
              <span class="h-3 leading-3">{locale === 'id' ? 'Jum' : 'Fri'}</span>
              <span class="h-3 leading-3"></span>
            </div>

            <div class="flex flex-1 justify-between gap-1">
              {contributions.weeks.map((week) => (
                <div class="flex flex-col gap-1">
                  {week.map((n, i) => (
                    <span
                      class="contrib-cell size-3"
                      data-level={contributionLevel(n)}
                      title={`${n} ${t.contribSection.on} ${dayNames[i]}`}
                    />
                  ))}
                </div>
              ))}
            </div>
          </div>

          <div class="mt-4 flex items-center justify-end gap-1.5 text-[0.7rem] text-fg-muted pl-8">
            <span>{t.contribSection.less}</span>
            {levels.map((l) => (
              <span class="contrib-cell size-3" data-level={l} aria-hidden="true" />
            ))}
            <span>{t.contribSection.more}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
