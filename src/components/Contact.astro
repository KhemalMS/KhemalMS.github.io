---
import { ui } from '../i18n/ui';
import { socialLinks } from '../data/site';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const links = socialLinks(locale);
---

<section id="contact" class="border-t border-line py-16 md:py-24">
  <div class="container-page">
    <p class="text-xs font-semibold tracking-widest text-accent uppercase">
      {t.contactSection.eyebrow}
    </p>
    <h2 class="mt-3 text-2xl font-bold sm:text-3xl">{t.contactSection.title}</h2>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted">
      {t.contactSection.subtitle}
    </p>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2">
      {
        links.map((l) => (
          <li>
            {l.href ? (
              <a
                href={l.href}
                class="group flex items-center justify-between gap-4 rounded-xl border border-line bg-surface px-4 py-3.5 transition-colors hover:border-accent"
                {...(l.href.startsWith('http')
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                <span class="flex flex-col gap-0.5">
                  <span class="text-xs font-semibold tracking-wide text-fg-muted uppercase">
                    {l.label}
                  </span>
                  <span class="text-sm font-medium text-fg">{l.value}</span>
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-4 shrink-0 text-fg-muted transition-transform group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </a>
            ) : (
              <div class="flex flex-col gap-0.5 rounded-xl border border-line bg-surface px-4 py-3.5">
                <span class="text-xs font-semibold tracking-wide text-fg-muted uppercase">
                  {l.label}
                </span>
                <span class="text-sm font-medium text-fg">{l.value}</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
