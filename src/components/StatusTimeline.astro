---
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/utils';
import { careerTimeline } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<section id="experience" class="border-t border-line bg-bg-subtle py-10 md:py-14">
  <div class="container-page">
    <p class="text-xs font-semibold tracking-widest text-accent uppercase">
      {t.timelineSection.eyebrow}
    </p>
    <h2 class="mt-3 text-2xl font-bold sm:text-3xl">{t.timelineSection.title}</h2>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted">
      {t.timelineSection.subtitle}
    </p>

    <ol class="mt-10 space-y-0 border-l border-line pl-6">
      {
        careerTimeline.map((item) => (
          <li class="relative pb-10 last:pb-0">
            <span
              class:list={[
                'absolute -left-[1.6875rem] top-1.5 size-2.5 rounded-full ring-4 ring-bg-subtle',
                item.status === 'current' ? 'bg-emerald-500' : 'bg-fg-muted/40',
              ]}
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="font-semibold tracking-tight text-fg">
                {item.role[locale]}
              </span>
              <span class="text-xs font-medium text-fg-muted">{item.period[locale]}</span>
              <span class="rounded-full border border-line bg-surface px-2.5 py-0.5 text-[0.7rem] font-medium text-accent">
                {item.organization}
              </span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted max-w-2xl">{item.description[locale]}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
