---
import { ui } from '../i18n/ui';
import { localizePath, type Locale } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const home = localizePath('/', locale);
const projectsHref = localizePath('/projects/', locale);
const onProjects = Astro.url.pathname.includes('/projects');

const links = [
  { href: `${home}#about`, label: t.nav.about, active: false },
  { href: projectsHref, label: t.nav.projects, active: onProjects },
  { href: `${home}#skills`, label: t.nav.skills, active: false },
  { href: `${home}#contact`, label: t.nav.contact, active: false },
];
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-bg/85 backdrop-blur-md supports-backdrop-filter:bg-bg/70"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href={home}
      class="font-semibold tracking-tight text-fg transition-opacity hover:opacity-70"
    >
      Khemal<span class="text-accent">.</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Utama">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              l.active ? 'bg-surface text-fg shadow-card' : 'text-fg-muted hover:text-fg',
            ]}
            aria-current={l.active ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangToggle locale={locale} />
      <ThemeToggle locale={locale} />

      <button
        type="button"
        id="nav-toggle"
        class="inline-flex size-9 items-center justify-center rounded-full border border-line text-fg-muted transition-colors hover:border-accent hover:text-fg md:hidden"
        aria-label={t.nav.menu}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
          class="size-4"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line bg-bg md:hidden">
    <nav class="container-page flex flex-col py-2" aria-label="Utama (seluler)">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-fg-muted transition-colors hover:bg-surface hover:text-fg"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  (() => {
    const btn = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!btn || !panel) return;

    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
    };

    btn.addEventListener('click', () => {
      setOpen(panel.classList.contains('hidden'));
    });

    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
        setOpen(false);
        btn.focus();
      }
    });
  })();
</script>
